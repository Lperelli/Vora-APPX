# Body analysis needs no environment variables.
#
# Body-type classification is 100% local:
#  - Measurements  → deterministic math in lib/body-classifier.ts
#  - Photos        → MediaPipe Pose runs entirely in the browser (lib/photo-flow.ts);
#                    the image is never uploaded.
#
# Lead registration needs the Apps Script deployment and a shared server secret.
# Set these in Webflow Cloud as server environment variables (never NEXT_PUBLIC_*).
# Keep the secret out of Git and match the Apps Script LEADS_SECRET property.
VORA_LEADS_WEBHOOK_URL=
VORA_LEADS_WEBHOOK_SECRET=
# Optional canonical origin if the host rewrites request URLs internally.
# VORA_APP_ORIGIN=https://vora-blog.webflow.io

# Publish and approve both legal documents before enabling consent or leads.
# These URLs and the approved version are public; set them before building.
NEXT_PUBLIC_VORA_TERMS_URL=
NEXT_PUBLIC_VORA_PRIVACY_URL=
NEXT_PUBLIC_VORA_LEGAL_VERSION=

# Read-only CMS token for the shared product catalog. Server secret only.
# The MCP manages content; the running app needs this separate CMS:read token.
WEBFLOW_CMS_API_TOKEN=
